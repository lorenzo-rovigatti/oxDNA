####  PROGRAM PARAMETERS  ####
backend = CPU
#debug = 1
#seed = 4982

####    SIM PARAMETERS    ####
sim_type = FFS_MD
steps = 1e6
newtonian_steps = 103
diff_coeff = 2.50
thermostat = john

T = 20C 
dt = 0.005
verlet_skin = 0.05

####     FFS PARAMETERS   ####
# The stopping condition cannot be satisfied by this system, so the run never
# terminates early and should reproduce the equivalent MD simulation in
# ../MD. Accordingly quick_compare uses the same reference value as
# ../MD/quick_compare.
order_parameters_file = op.txt
ffs_file = conditions.txt

####    INPUT / OUTPUT    ####
topology = ../dsdna8.top
conf_file = ../init.dat
trajectory_file = trajectory.dat
refresh_vel = 1
log_file = log.dat
no_stdout_energy = 1
restart_step_counter = 1
energy_file = energy.dat
print_conf_interval = 1e5
print_energy_every = 1e3 
time_scale = linear
external_forces = 0
