# Mixed DNA/RNA/protein system: the hybrid cage with every other DNA strand turned into RNA.
# Regression value of the step-0 potential energy (the RNA strands use the DNA geometry, so this is not a relaxed structure)
backend = CPU
backend_precision = double
interaction_type = NANM
salt_concentration = 1.0
sim_type = MD
steps = 0
thermostat = john
T = 300K
dt = 0.001
verlet_skin = 0.05
diff_coeff = 2.5
newtonian_steps = 103
parfile = ../../../../examples/DNANM/hybrid_cage/ac.par
topology = cage_mixed.top
conf_file = ../../new_topology/hybrid_cage/cage_new.dat
trajectory_file = trajectory.dat
lastconf_file = last_conf.dat
refresh_vel = 1
seed = 1
restart_step_counter = 1
energy_file = energy.dat
print_conf_interval = 1000
print_energy_every = 1000
time_scale = linear

